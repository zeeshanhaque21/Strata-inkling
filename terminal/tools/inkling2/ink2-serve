#!/bin/bash
# ink2-serve start|stop|status|logs: Inkling-2-Mini on the Strata engine, one engine per GPU behind a pool, as systemd user services.
# Defaults: 2 GPUs, 128K context per stream, int8 KV, DSpark drafter (--spec 1), 4 client streams (2 run at once, 2 wait), port 8080 on localhost.
# Override with env: GPUS="0 1" CTX=131072 KV=i8 RESERVE=1500 SPEC=1 PORT=8080 HOST=127.0.0.1 MODEL=... ENGINE=... Q8=1
# Q8: int8 dense weights, bit mask: 1 = unembedding (default, no measurable quality cost), 7 = also wo and q/k/v (faster, see docs), 0 = all BF16
set -u
GPUS=${GPUS:-"0 1"}; CTX=${CTX:-131072}; KV=${KV:-i8}; RESERVE=${RESERVE:-1500}; SPEC=${SPEC:-1}; PORT=${PORT:-8080}; HOST=${HOST:-127.0.0.1}
MODEL=${MODEL:-/mnt/models/inkling-official}
HERE=$(cd "$(dirname "$0")" && pwd)
ENGINE=${ENGINE:-$HOME/strata-inkling/build-sm75/strata-ink2}
PY=${PY:-$HOME/gpu-stress/.venv/bin/python}
LOGDIR=${LOGDIR:-$HOME/strata-inkling/runs/serve-logs}; mkdir -p "$LOGDIR"
unit() { echo "ink2-gpu$1"; }
case "${1:-status}" in
  start)
    backends=(); i=0
    for g in $GPUS; do
      p=$((8101 + i)); i=$((i + 1)); backends+=(--backend "http://127.0.0.1:$p")
      systemctl --user reset-failed "$(unit $g)" 2>/dev/null
      systemd-run --user --unit="$(unit $g)" --collect -p Restart=on-failure -p RestartSec=10 \
        -E CUDA_VISIBLE_DEVICES="$g" -E LD_LIBRARY_PATH=/opt/cuda/lib64 -E INK2_Q8="${Q8:-1}" \
        -p StandardOutput=append:"$LOGDIR/gpu$g.out" -p StandardError=append:"$LOGDIR/gpu$g.out" \
        "$PY" "$HERE/ink2_shim.py" --engine "$ENGINE" --model "$MODEL" --host 127.0.0.1 --port "$p" --ctx "$CTX" --chunk 512 --tc 1 \
        --log "$LOGDIR/engine-gpu$g.log" --engine-args "--kv $KV --vram-reserve-mib $RESERVE --spec $SPEC" >/dev/null
    done
    systemctl --user reset-failed ink2-pool 2>/dev/null
    systemd-run --user --unit=ink2-pool --collect -p Restart=on-failure -p RestartSec=5 \
      -p StandardOutput=append:"$LOGDIR/pool.out" -p StandardError=append:"$LOGDIR/pool.out" \
      "$PY" "$HERE/ink2_pool.py" "${backends[@]}" --host "$HOST" --port "$PORT" >/dev/null
    echo "started; wait for: $0 status" ;;
  stop)
    for g in $GPUS; do systemctl --user stop "$(unit $g)" 2>/dev/null; done; systemctl --user stop ink2-pool 2>/dev/null; echo stopped ;;
  logs) tail -n 20 "$LOGDIR"/*.out ;;
  status)
    for g in $GPUS; do printf '%s: %s\n' "$(unit $g)" "$(systemctl --user is-active "$(unit $g)")"; done
    printf 'ink2-pool: %s\n' "$(systemctl --user is-active ink2-pool)"
    curl -s --max-time 5 "http://$HOST:$PORT/health"; echo ;;
  *) echo "usage: $0 start|stop|status|logs"; exit 2 ;;
esac
